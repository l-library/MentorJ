<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>edu.mentorj.MentorJ</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>MentorJ</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/l-library">l-library</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        MentorJ is a teaching assistant plugin for the Java Enterprise Application Development course,
        built for Java learners working in IntelliJ IDEA. It lives in a side tool window as an AI agent
        and provides course Q&amp;A grounded in course materials with cited sources, context-aware
        programming assistance, JUnit test generation from natural-language requirements, and
        Conventional Commits style git commit message generation.
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>


    <!-- Text bundle; actions take their text/description from here. -->
    <resource-bundle>messages.MentorJBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Sidebar AI agent UI (UI team): the tool window for talking to the teaching assistant. The sidebar button, the plugin list and the menu items share one icon. -->
        <toolWindow id="MentorJ" anchor="right" icon="/icons/mentorj/mentorj.svg"
                    factoryClass="edu.mentorj.ui.MentorJToolWindowFactory"/>
    </extensions>

    <!-- Intelligent action entry points (UI team). -->
    <actions>
        <!-- Ask about selected code: editor context menu entry. Text comes from the bundle's action.<id>.text/.description. -->
        <action id="edu.mentorj.AskCode" class="edu.mentorj.ui.AskCodeAction"
                icon="/icons/mentorj/mentorj.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <!-- Generate unit test: editor context menu entry. -->
        <action id="edu.mentorj.GenerateUnitTest" class="edu.mentorj.ui.GenerateUnitTestAction"
                icon="/icons/mentorj/mentorj.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <!-- Generate practice exercises: the F1 creative intelligent action, an editor context menu entry. -->
        <action id="edu.mentorj.GeneratePractice" class="edu.mentorj.ui.GeneratePracticeAction"
                icon="/icons/mentorj/mentorj.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <!-- Generate Git commit message: parked in the Tools menu, may move to the commit dialog later. -->
        <action id="edu.mentorj.GenerateCommitMessage" class="edu.mentorj.ui.GenerateCommitMessageAction"
                icon="/icons/mentorj/mentorj.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>

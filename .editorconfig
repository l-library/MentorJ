root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Java indentation: 4 spaces
[*.{java,py,xml}]
indent_size = 4

# Trailing spaces are meaningful in Markdown (hard line breaks), so do not trim them
[*.md]
trim_trailing_whitespace = false

# Windows batch files must use CRLF (consistent with .gitattributes)
[*.{bat,cmd}]
end_of_line = crlf
